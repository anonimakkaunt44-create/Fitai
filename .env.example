# ====================================================================
# FitAI Telegram Mini App - Environment Variables & Cloudflare Secrets
# ====================================================================

# --------------------------------------------------------------------
# 1. Cloudflare Secrets (Задаются в Cloudflare Dashboard -> Settings -> Variables and Secrets)
# --------------------------------------------------------------------

# Google Gemini API Key: Получите бесплатно в Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# Telegram Bot Token: Получите у @BotFather в Telegram (например, 7812345678:AAH...)
TELEGRAM_BOT_TOKEN=""

# Секретный токен вебхука Telegram для защиты от спама и поддельных запросов (любая случайная строка из 32 символов)
TELEGRAM_WEBHOOK_SECRET="fitai_tg_secret_random_string_2025"

# Telegram ID администратора (числовой ID, узнать можно через бота @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=""

# Никнеймы администраторов в Telegram через запятую (без знака @)
ADMIN_USERNAMES="luckmepubg,timurcik"

# Секретный ключ для подписи JWT-токенов сессий и админ-панели (случайная длинная строка)
JWT_SECRET="fitai_jwt_production_secret_key_change_me_12345"
ADMIN_SECRET_KEY="fitai_jwt_production_secret_key_change_me_12345"

# Пароль для первого входа в админ-панель (логин: admin)
INITIAL_ADMIN_PASSWORD="ChooseYourSecurePasswordHere2025"

# Публичный URL вашего приложения в Cloudflare (например, https://fitai-telegram-app.your-subdomain.workers.dev)
APP_URL=""

# --------------------------------------------------------------------
# 2. GitHub Secrets (Для автоматического деплоя через GitHub Actions)
# --------------------------------------------------------------------
# CLOUDFLARE_API_TOKEN: Токен API Cloudflare с правами "Edit Cloudflare Workers"
# CLOUDFLARE_ACCOUNT_ID: ID вашего аккаунта Cloudflare (находится в адресной строке или на главной странице дашборда)
