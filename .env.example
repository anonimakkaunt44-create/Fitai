# =======================================================
# FitAI Telegram Mini App - Environment Variables
# =======================================================

# GEMINI_API_KEY: Required for AI Trainer, Meal Planning, Workout Generation & Food Photo Vision
# In AI Studio, automatically injected or configured via Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Telegram Bot Token from @BotFather (e.g., 7812345678:AAH...)
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_ADMIN_CHAT_ID: Telegram numeric ID of the administrator receiving payment checks & alerts (e.g., 123456789)
TELEGRAM_ADMIN_CHAT_ID="MY_TELEGRAM_ADMIN_ID"

# ADMIN_USERNAMES: Telegram usernames of administrators (without @, comma-separated, e.g. luckmepubg)
ADMIN_USERNAMES="luckmepubg"

# ADMIN_SECRET_KEY: Secret key used to sign JWT tokens for the Admin Panel
ADMIN_SECRET_KEY="fitai_super_secret_jwt_key_change_in_production"

# Default Admin Credentials (initialized on first boot if not existing)
ADMIN_DEFAULT_USER="admin"
ADMIN_DEFAULT_PASSWORD="admin_fitai_secure_2025"
ADMIN_PASSWORD=""

# APP_URL: The public URL where this Mini App is hosted (e.g., https://your-domain.com or Cloud Run URL)
APP_URL="MY_APP_URL"

